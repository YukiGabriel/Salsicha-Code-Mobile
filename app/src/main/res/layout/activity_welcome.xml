<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcomeRoot"
    android:orientation="vertical"
    android:background="#171114"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="logo" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌭 Salsicha Code"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFF9F7"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bem-vindo • escolha um projeto"
                android:textSize="12sp"
                android:textColor="#A89B9E"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnNew"
            style="@style/RunButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="＋ Criar projeto" />

        <Space
            android:layout_width="10dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnOpen"
            style="@style/BarButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="42dp"
            android:text="📂 Abrir projeto" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:text="Recentes"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#A89B9E"
        android:fontFamily="monospace" />

    <ListView
        android:id="@+id/recentList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:text="Nenhum projeto ainda.\nCrie o primeiro 🌭"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="#5A4A4E"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnFile"
        style="@style/BarButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="18dp"
        android:text="📄 abrir arquivo avulso" />

</LinearLayout>
