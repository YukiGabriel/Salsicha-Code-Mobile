<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SalsichaCode" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/salsicha_accent</item>
        <item name="colorPrimaryDark">#171114</item>
        <item name="colorAccent">@color/salsicha_accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">#171114</item>
        <item name="android:navigationBarColor">#171114</item>
        <item name="android:alertDialogTheme">@style/Theme.SalsichaCode.Dialog</item>
    </style>

    <style name="Theme.SalsichaCode.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/salsicha_accent</item>
        <item name="colorAccent">@color/salsicha_accent</item>
    </style>

    <style name="Theme.SalsichaCode.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/salsicha_accent</item>
        <item name="colorAccent">@color/salsicha_accent</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#171114</item>
        <item name="android:navigationBarColor">#171114</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="BarButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">13sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TabButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_tab</item>
    </style>

    <style name="SymbolButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">15sp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="RunButton" parent="Widget.AppCompat.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/bg_run_fab</item>
        <item name="android:textColor">#171114</item>
    </style>
</resources>
